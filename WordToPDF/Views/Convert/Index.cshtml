@model WordToPDF.Models.ConvertViewModel
@using System.IO

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />



<div class="container mt-4">
    <div class="card shadow p-4">
        <h3 class="text-center mb-4">PDF ↔ Word Converter</h3>

        @using (Html.BeginForm("Index", "Convert", FormMethod.Post, new { enctype = "multipart/form-data", id = "convertForm" }))
        {
            <input type="file" id="fileInput" name="File" style="display:none" />

            <div id="uploadBox" class="upload-box">
                <h5>Drag & Drop File Here</h5>
                <p>or click to browse</p>
            </div>

            <!-- Preview -->
            <div id="preview-area" class="text-center mt-3"></div>

            <label class="mt-4">Select Conversion:</label>
            <select name="ConvertType" class="form-select">
                <option value="PDFtoWord">PDF → Word</option>
                <option value="WordToPDF">Word → PDF</option>
            </select>

            <!-- Progress Bar -->
            <div id="progress-container" style="display:none">
                <label class="mt-3">Processing...</label>
                <div class="progress">
                    <div id="realProgress"
                         class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: 0%">
                    </div>
                </div>
            </div>
  

            <button class="btn btn-primary mt-4 w-100" type="submit">Convert</button>
        }
    </div>
</div>
<script>
    const uploadBox = document.getElementById("uploadBox");
    const fileInput = document.getElementById("fileInput");
    const previewArea = document.getElementById("preview-area");

    uploadBox.addEventListener("click", () => fileInput.click());

    uploadBox.addEventListener("dragover", function (e) {
        e.preventDefault();
        uploadBox.classList.add("dragover");
    });

    uploadBox.addEventListener("dragleave", function () {
        uploadBox.classList.remove("dragover");
    });

    uploadBox.addEventListener("drop", function (e) {
        e.preventDefault();
        uploadBox.classList.remove("dragover");
        fileInput.files = e.dataTransfer.files;
        showPreview(e.dataTransfer.files[0]);
    });

    fileInput.addEventListener("change", function () {
        showPreview(this.files[0]);
    });

    function showPreview(file) {
        if (!file) return;

        const fileName = file.name;
        const ext = fileName.split('.').pop().toLowerCase();

        let icon = "";
        if (ext === "pdf") icon = "/Content/pdf-icon.png";
        else if (ext === "doc" || ext === "docx") icon = "/Content/word-icon.png";
        else icon = "/Content/file-icon.png";

        uploadBox.innerHTML = `
            <div class="d-flex flex-column align-items-center justify-content-center" style="height:150px;">
                <img src="${icon}" style="width:60px; margin-bottom:10px;" />
                <strong>${fileName}</strong>
            </div>
        `;
    }

    document.getElementById("convertForm").addEventListener("submit", function () {
        document.getElementById("progress-container").style.display = "block";
    });

    function showPreview(file) {
        if (!file) return;

        const fileName = file.name;

        uploadBox.innerHTML = `
        <div class="d-flex flex-column align-items-center justify-content-center" style="height:150px;">
            
            <!-- Green Check Icon -->
            <div style="
                width: 60px; 
                height: 60px; 
                border-radius: 50%; 
                background: #28a745; 
                display: flex; 
                align-items: center; 
                justify-content: center;
                margin-bottom: 10px;">
                
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                    <path d="M20 6L9 17L4 12" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

            </div>

            <strong>${fileName}</strong>
        </div>
    `;
    }

    function startRealProgress() {
        const bar = document.getElementById("realProgress");

        let interval = setInterval(() => {
            fetch('/Convert/GetProgress')
                .then(res => res.json())
                .then(data => {

                    bar.style.width = data.progress + "%";

                    if (data.progress >= 100) {
                        clearInterval(interval);
                    }
                });

        }, 500);
    }

    document.getElementById("convertForm").addEventListener("submit", function () {
        document.getElementById("progress-container").style.display = "block";
        startRealProgress();
    });


</script>
