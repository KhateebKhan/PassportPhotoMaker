@{
    ViewBag.Title = "Preview";
}

<link href="~/Content/pdfconvert.css" rel="stylesheet" />

<div class="container mt-5 text-center">
    <h2>Preview</h2>
    <p class="text-muted">@ViewBag.FileName</p>

    <!-- MAIN PREVIEW -->
    @if (ViewBag.Extension == ".pdf")
    {
        <div style="display:flex;justify-content:center">
            <iframe src="@Url.Action("Stream", "Home", new { file = ViewBag.FileName })"
                    style="width:70%;height:80vh;border:0;"></iframe>
        </div>
    }
    else
    {
        <div class="preview-card d-inline-block">
            <div class="preview-inner">
                <div class="preview-thumb" style="width:220px;height:300px;">
                    <i class="bi bi-file-earmark-word-fill text-primary" style="font-size:80px"></i>
                </div>
                <div class="preview-name mt-2 text-truncate">@ViewBag.FileName</div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a class="btn btn-primary me-2"
           href="@Url.Action("Download", "Home", new { file = ViewBag.FileName })">Download</a>

        <a class="btn btn-secondary"
           href="@Url.Action("Index", "Home")">Back</a>
    </div>
</div>


<!-- ========================= -->
<!-- Floating Add Button -->
<!-- ========================= -->
<div class="floating-add fixed-right" id="floatingAdd">
    <div class="badge-count" id="badgeCount">0</div>
    <button type="button" class="add-btn" id="addFilesBtn">+</button>
</div>

<form id="multiUploadForm" style="display:none" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="file" id="multiFileInput" name="file"
           multiple accept=".pdf,.doc,.docx" />
</form>

<div class="preview-gallery container mt-4">
    <h4>Files</h4>
    <div id="gallery" class="d-flex flex-wrap justify-content-start gap-3"></div>
</div>


@section scripts {
    <script>
(function(){

    var addBtn = document.getElementById('addFilesBtn');
    var fileInput = document.getElementById('multiFileInput');
    var gallery = document.getElementById('gallery');
    var badge = document.getElementById('badgeCount');

    var filesCount = 0;
    var maxFiles = 10;

    function updateBadge(){
        badge.textContent = filesCount;
    }

    // CLICK + BUTTON
    addBtn.addEventListener('click', function(){
        fileInput.click();
    });

    // WHEN USER SELECTS FILES
    fileInput.addEventListener('change', function(){

        var files = Array.from(fileInput.files);
        if(files.length == 0) return;

        var remain = maxFiles - filesCount;
        var allowed = files.slice(0, remain);

        allowed.forEach(f => {
            addToGallery(f);
            ajaxUploadSingle(f);
        });

        filesCount += allowed.length;
        updateBadge();

        fileInput.value = "";
    });

    function addToGallery(file){
        var card = document.createElement("div");
        card.className = "preview-card";
        card.style.width = "140px";
        card.innerHTML =
            `<div class="preview-inner">
                <div class="preview-thumb"
                     style="width:120px;height:160px;display:flex;align-items:center;justify-content:center;background:#fff">
                     <i class="bi bi-file-earmark-pdf-fill text-danger" style="font-size:40px"></i>
                </div>
                <div class="preview-name text-truncate" style="max-width:120px">${file.name}</div>
            </div>`;

        gallery.appendChild(card);
    }

    // AJAX UPLOAD
    function ajaxUploadSingle(f){
        var form = document.getElementById("multiUploadForm");
        var token = form.querySelector("input[name='__RequestVerificationToken']").value;

        var fd = new FormData();
        fd.append("file", f);
        fd.append("conversion", "pdf2docx");  // default
        fd.append("__RequestVerificationToken", token);

        fetch("@Url.Action("Upload","Home")", {
            method: "POST",
            body: fd,
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
        .then(r => r.json())
        .then(json => {
            if(json.success){
                console.log("Uploaded:", json.file);
            }
            else{
                alert(json.message);
            }
        });
    }

    // center the floating button
    function positionFloating(){
        var h = window.innerHeight;
        document.getElementById("floatingAdd").style.top = (h/2 - 24) + "px";
    }
    positionFloating();
    window.addEventListener("resize", positionFloating);

})();
    </script>
}
