@model PhotoMaker.Models.PhotoResultViewModel
@{
    ViewBag.Title = "Final Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="result-wrapper">

    <h2 class="text-center">Final Result</h2>
    <p class="text-center text-muted">Your passport photo has been processed successfully</p>

    <div class="result-grid">

        <!-- ORIGINAL -->
        <div>
            <h4 class="text-center">Original</h4>
            <div class="img-box">
                <img src="@Model.OriginalImagePath" class="auto-img" />
            </div>
        </div>

        <!-- RESULT (FIXED REAL SIZE) -->
        <div>
            <h4 class="text-center">Result</h4>
            <div class="img-box real-size-box">

                <!-- ⭐ SHOW EXACT PASSPORT SIZE -->
                <img id="finalPhoto"
                     src="@Model.ProcessedImagePath"
                     width="@Model.WidthPx"
                     height="@Model.HeightPx"
                     class="real-size-img" />
            </div>
        </div>

        <!-- FINAL SHEET -->
        <div>
            <h4 class="text-center">Final Sheet</h4>
            <div class="img-box">
                <img src="@Model.FinalSheetImagePath" class="auto-img" />
            </div>
        </div>

    </div>

    <div class="action-area">
        <a href="@Model.FinalSheetImagePath" download class="btn btn-primary download-btn">
            Download HD (Sheet)
        </a>
    </div>

</div>



