@model PhotoMaker.Models.PhotoResultViewModel
@{
    ViewBag.Title = "Final Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- GRID STYLING -->
<style>
    .result-wrapper {
        max-width: 1200px;
        margin: 30px auto;
    }

    .result-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr; /* 3 columns */
        gap: 40px;
        align-items: start;
        margin-top: 40px;
    }

    .img-box {
        background: #fff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 450px;
    }

        .img-box img {
            max-width: 100%;
            max-height: 100%;
            border-radius: 12px;
        }

    .action-area {
        text-align: center;
        margin-top: 25px;
    }

    .download-btn {
        padding: 12px 25px;
        font-size: 18px;
        border-radius: 8px;
    }
</style>

<div class="result-wrapper">

    <h2 class="text-center">Final Result</h2>
    <p class="text-center text-muted">Your passport photo has been processed successfully</p>

    <!-- ⭐ 3-COLUMN GRID ⭐ -->
    <div class="result-grid">

        <!-- ORIGINAL -->
        <div>
            <h4 class="text-center">Original</h4>
            <div class="img-box">
                <img src="@Model.OriginalImagePath" />
            </div>
        </div>

        <!-- RESULT -->
        <div>
            <h4 class="text-center">Result</h4>
            <div class="img-box">
                <img src="@Model.ProcessedImagePath" />
            </div>
        </div>

        <!-- ⭐ FINAL SHEET (NOW INSIDE GRID) ⭐ -->
        <div>
            <h4 class="text-center">Final Sheet</h4>
            <div class="img-box">
                <img src="@Model.FinalSheetImagePath" />
            </div>
        </div>

    </div>

    <!-- DOWNLOAD SHEET BUTTON -->
    <div class="action-area">
        <a href="@Model.FinalSheetImagePath" download class="btn btn-primary download-btn">
            Download HD (Sheet)
        </a>
    </div>

</div>
