@{
    ViewBag.Title = "Upload Passport Photo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="upload-container">

    <!-- Title -->
    <h1 class="main-title">
        Create your own professional passport photo<br />
        <span class="sub">online With Single–Click in One Second</span>
    </h1>

    <p class="desc">100% Automatic — Fast & Free</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }

    <!-- Upload Box -->
    <div class="upload-box">

        @using (Html.BeginForm("Upload", "Photo", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <!-- DROP ZONE -->
            <label class="drop-area" id="dropZone" >
                <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                <div class="upload-text">Upload Image</div>
                <div class="upload-sub">or drop a file here<br />CTRL+V to paste image or URL</div>
            </label>

            <input type="file" id="photo" name="photo" accept="image/*" hidden/>

            <!-- Example Faces -->
            <div class="examples">
                No image? Try one of these:
                <div class="example-row">
                    <img src="/Content/img/sample1.jpg" />
                    <img src="/Content/img/sample2.jpg" />
                    <img src="/Content/img/sample3.jpg" />
                </div>
            </div>

            <!-- APP BUTTON -->
            <a class="free-app-btn" href="#">
                <i class="fa-brands fa-apple"></i> Free Passport Photo App →
            </a>

            <!-- SETTINGS -->
            <!--<div class="form-settings">

                <label><strong>Passport Size</strong></label>
                <select name="SizeType" class="form-control">
                    <option value="EU">EU – 35×45 mm</option>
                    <option value="US">US – 2×2 inch</option>
                    <option value="Custom">Custom</option>
                </select>

                <label class="mt-3"><strong>Background Color</strong></label>
                <select name="BackgroundColor" class="form-control">
                    <option value="white" selected>White</option>
                    <option value="#43b0f1">Blue</option>
                    <option value="gray">Gray</option>
                    <option value="transparent">Transparent</option>
                </select>

                <label class="mt-3"><strong>Photos per Sheet</strong></label>
                <select name="SheetCount" class="form-control">
                    <option value="1">1 Photo</option>
                    <option value="2">2 Photos</option>
                    <option value="4">4 Photos</option>
                    <option value="6" selected>6 Photos</option>
                </select>
            </div>-->

            <button type="submit" class="main-upload-btn mt-4">
                Upload & Continue →
            </button>
        }
    </div>
</div>

<script>
    const dropZone = document.getElementById("dropZone");
    const fileInput = document.getElementById("photo");

    dropZone.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", () => {
        if (fileInput.files.length > 0) showSelectedFile();
    });

    dropZone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropZone.classList.add("dragover");
    });

    dropZone.addEventListener("dragleave", () => {
        dropZone.classList.remove("dragover");
    });

    dropZone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZone.classList.remove("dragover");

        if (e.dataTransfer.files.length > 0) {
            const dt = new DataTransfer();
            dt.items.add(e.dataTransfer.files[0]);
            fileInput.files = dt.files;
            showSelectedFile();
        }
    });

    function showSelectedFile() {
        const file = fileInput.files[0];
        dropZone.innerHTML = `
            <div style='font-size:18px; font-weight:600;'>✔ Selected:</div>
            <div>${file.name}</div>
        `;
    }
</script>
