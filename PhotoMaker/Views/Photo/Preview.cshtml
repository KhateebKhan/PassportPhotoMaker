@model PhotoMaker.Models.PhotoResultViewModel

@{
    ViewBag.Title = "Preview";
    Layout = "~/Views/Shared/_PreviewLayout.cshtml";
}

@using (Html.BeginForm("Result", "Photo", FormMethod.Post, new { id = "previewForm" }))
{
    @Html.Hidden("OriginalImageName", Model.OriginalImageName)
    @Html.Hidden("BackgroundColor", Model.BackgroundColor)
    @Html.Hidden("SheetCount", Model.SheetCount)

    @Html.Hidden("WidthPx", Model.WidthPx)
    @Html.Hidden("HeightPx", Model.HeightPx)

    @Html.Hidden("PaperWidth")
    @Html.Hidden("PaperHeight")
    @Html.Hidden("SelectedPaperSize")

    <div class="modal-wrapper">

        <!-- TOP BAR -->
        <div class="topbar">
            <button type="button" id="doneBtn" class="done-btn">Done</button>
            <span class="close-btn">✕</span>
        </div>

        <div class="editor">

            <!-- LEFT SIDE -->
            <div class="left-panel">

                <label class="label-main">Paper Size</label>

                <select class="dropdown" name="SelectedPaperSize" id="paperSize">

                    <option value="single">Individual / Single Photo</option>

                    <option value="3R">3.5 × 5 inch (3R)</option>
                    <option value="4R">6 × 4 inch (4R)</option>
                    <option value="5R">7 × 5 inch (5R) (2L)</option>

                    <option value="A5">A5 (21 × 14.85 cm)</option>
                    <option value="A4">A4 (29.7 × 21 cm)</option>
                    <option value="letter">Letter (8.5 × 11 inch)</option>
                    <option value="legal">Legal (8.5 × 14 inch)</option>
                </select>
                <!-- Passport Size -->
                <label class="label-main mt">Passport Size</label>
                @*<select id="sizeType" name="SizeType" class="dropdown">
                        <option value="EU">EU – 35×45 mm</option>
                        <option value="US">US – 2×2 inch</option>
                        <option value="Custom">Custom</option>
                    </select>*@

                <!-- Background Color -->
                <label class="label-main mt">Background Color</label>
                <select id="bgColor" name="BackgroundColor" class="dropdown">
                    <option value="white">White</option>
                    <option value="#43b0f1">Blue</option>
                    <option value="gray">Gray</option>
                    <option value="transparent">Transparent</option>
                </select>

                <!-- Photos per Sheet -->
                <label class="label-main mt">Photos per Sheet</label>
                <select id="sheetCount" name="SheetCount" class="dropdown">
                    <option value="1">1 Photo</option>
                    <option value="2">2 Photos</option>
                    <option value="4">4 Photos</option>
                    <option value="6">6 Photos</option>
                    <option value="8">8 Photos</option>
                </select>


                <label class="label-main mt">Custom size</label>

                <div class="size-row">
                    <input id="widthInput" class="size-input" name="WidthPx" value="@Model.WidthPx" />
                    <span class="x-sign">×</span>
                    <input id="heightInput" class="size-input" name="HeightPx" value="@Model.HeightPx" />
                </div>

                <div class="sizes-list">
                    <div class="size-card selected" onclick="selectSize(413,531, this)">
                        <strong>USA (Passport)</strong>
                        <div class="small">(2×2 inch) 600×600px</div>
                    </div>
                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>UK (Passport)</strong>
                        <div class="small">(35×45mm) 900×1200px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>EU (Passport)</strong>
                        <div class="small">(35×45mm) 413×531px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>Germany (Passport)</strong>
                        <div class="small">(35×45mm) 413×531px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>France (Passport)</strong>
                        <div class="small">(35×45mm) 413×531px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>Australia (Passport)</strong>
                        <div class="small">(35×45mm) 600×750px</div>
                    </div>


                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>India (Passport)</strong>
                        <div class="small">(2×2 inch) 413×531px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>Pakistan (Passport)</strong>
                        <div class="small">(35×45mm) 413×531px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>Bangladesh (Passport)</strong>
                        <div class="small">(35×45mm) 300×350px</div>
                    </div>

                    <div class="size-card" onclick="selectSize(413,531, this)">
                        <strong>UAE (Emirates ID)</strong>
                        <div class="small">(45×35mm) 420×540px</div>
                    </div>




                </div>

            </div>

            <!-- RIGHT PREVIEW -->
            <div class="preview-area">
                <div class="preview-frame">
                    <img id="previewPhoto" src="@Model.OriginalImagePath" />
                </div>
            </div>

        </div>
    </div>

} <!-- END FORM -->
@section scripts{
    <script>

        // -------- DONE BUTTON --------
        document.getElementById("doneBtn").addEventListener("click", function () {

            // Update hidden fields
            document.querySelector("input[name='WidthPx']").value = widthInput.value;
            document.querySelector("input[name='HeightPx']").value = heightInput.value;
            document.querySelector("input[name='BackgroundColor']").value = document.getElementById("bgColor").value;
            document.querySelector("input[name='SheetCount']").value = document.getElementById("sheetCount").value;
            document.querySelector("input[name='SelectedPaperSize']").value = document.getElementById("paperSize").value;

            // Submit
            document.getElementById("previewForm").submit();
        });


        // -------- LIVE PREVIEW --------
        const previewPhoto = document.getElementById("previewPhoto");
        const widthInput = document.getElementById("widthInput");
        const heightInput = document.getElementById("heightInput");

        function updatePreview() {
            previewPhoto.style.width = widthInput.value + "px";
            previewPhoto.style.height = heightInput.value + "px";
        }

        widthInput.addEventListener("input", updatePreview);
        heightInput.addEventListener("input", updatePreview);


        // -------- SELECT SIZE CARDS --------
        function selectSize(w, h, el) {
            widthInput.value = w;
            heightInput.value = h;

            updatePreview();

            document.querySelectorAll('.size-card')
                .forEach(card => card.classList.remove('selected'));

            el.classList.add('selected');
        }


        // Auto select default size on load
        document.addEventListener("DOMContentLoaded", function () {
            const def = document.querySelector(".size-card.selected");
            if (def) def.click();
        });


        // -------- PAPER SIZE HANDLER --------

        document.getElementById("paperSize").addEventListener("change", function () {

            let w = null, h = null;

            switch (this.value) {

                case "3R":      // 3.5 x 5 inch
                    w = 1050; h = 1500;
                    break;

                case "4R":      // 6 × 4 inch
                    w = 1800; h = 1200;
                    break;

                case "5R":      // 7 × 5 inch
                    w = 2100; h = 1500;
                    break;

                case "A5":      // portrait
                    w = 1748; h = 2480;
                    break;

                case "A4":      // portrait
                    w = 2480; h = 3508;
                    break;

                case "letter":
                    w = 2550; h = 3300;
                    break;

                case "legal":
                    w = 2550; h = 4200;
                    break;
            }

            document.querySelector("input[name='PaperWidth']").value = w;
            document.querySelector("input[name='PaperHeight']").value = h;
        });


        // -------- BACKGROUND COLOR LIVE --------
        document.getElementById("bgColor").addEventListener("change", function () {
            previewPhoto.style.background = this.value;
        });

        // -------- SHEET COUNT LIVE --------
        document.getElementById("sheetCount").addEventListener("change", function () {
            document.querySelector("input[name='SheetCount']").value = this.value;
        });

    </script>
}

}
